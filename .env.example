# Hugging Face API Configuration
HUGGINGFACE_API_KEY=your_api_key_here

# Model Settings
MODEL_CACHE_DIR=./model_cache
DEVICE=cpu
ENABLE_GPU=false

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Batch Processing
BATCH_SIZE=32
MAX_LENGTH=512

# Logging
LOG_LEVEL=INFO
